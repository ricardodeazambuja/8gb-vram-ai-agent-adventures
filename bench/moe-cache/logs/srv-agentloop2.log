ssert inv.total_items() == 15\\n\\n    def test_total_items_after_restock(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        inv.restock(\\\"Apple\\\", 20)\\n        assert inv.total_items() == 30\\n\\n\\nclass TestInventoryAccess:\\n    \\\"\\\"\\\"Tests for inventory access methods.\\\"\\\"\\\"\\n\\n    def test_get_item(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        item = inv.get_item(\\\"Apple\\\")\\n        assert item is not None\\n        assert item.name == \\\"Apple\\\"\\n\\n    def test_get_item_not_found(self):\\n        inv = Inventory()\\n        assert inv.get_item(\\\"Apple\\\") is None\\n\\n    def test_has_item(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        assert inv.has_item(\\\"Apple\\\") is True\\n        assert inv.has_item(\\\"Banana\\\") is False\\n\\n    def test_contains_operator(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        assert \\\"Apple\\\" in inv\\n        assert \\\"Banana\\\" not in inv\\n\\n    def test_getitem_operator(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        item = inv[\\\"Apple\\\"]\\n        assert item.name == \\\"Apple\\\"\\n\\n    def test_getitem_nonexistent_raises(self):\\n        inv = Inventory()\\n        with pytest.raises(KeyError, match=\\\"not found\\\"):\\n            _ = inv[\\\"Banana\\\"]\\n\\n    def test_remove_item(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        inv.remove_item(\\\"Apple\\\")\\n        assert len(inv) == 0\\n\\n    def test_remove_item_nonexistent_raises(self):\\n        inv = Inventory()\\n        with pytest.raises(KeyError, match=\\\"not found\\\"):\\n            inv.remove_item(\\\"Apple\\\")\\n\\n    def test_get_all_items(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        inv.add(\\\"Banana\\\", 5, 0.49)\\