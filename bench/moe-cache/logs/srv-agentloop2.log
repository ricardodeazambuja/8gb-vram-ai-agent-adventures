[\\\"price\\\"] == 0.99\\n        finally:\\n            os.unlink(filepath)\\n\\n    def test_load_nonexistent_file_raises(self):\\n        with pytest.raises(FileNotFoundError):\\n            Inventory.load_from_json(\\\"nonexistent_file.json\\\")\\n\\n\\nclass TestInventoryRepr:\\n    \\\"\\\"\\\"Tests for string representations.\\\"\\\"\\\"\\n\\n    def test_repr_empty(self):\\n        inv = Inventory()\\n        assert \\\"Inventory\\\" in repr(inv)\\n\\n    def test_str_empty(self):\\n        inv = Inventory()\\n        assert \\\"empty\\\" in str(inv)\\n\\n    def test_str_with_items(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        s = str(inv)\\n        assert \\\"Apple\\\" in s\\n        assert \\\"10\\\" in s\\n        assert \\\"0.99\\\" in s\\n        assert \\\"Total\\\" in s\\n\\n\\nclass TestInventoryEdgeCases:\\n    \\\"\\\"\\\"Tests for edge cases.\\\"\\\"\\\"\\n\\n    def test_add_zero_quantity(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 0, 0.99)\\n        assert inv.get_quantity(\\\"Apple\\\") == 0\\n\\n    def test_add_zero_price(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.0)\\n        assert inv.get_quantity(\\\"Apple\\\") == 10\\n\\n    def test_remove_zero_quantity(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        inv.remove(\\\"Apple\\\", 0)\\n        assert inv.get_quantity(\\\"Apple\\\") == 10\\n\\n    def test_restock_zero_quantity(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 10, 0.99)\\n        inv.restock(\\\"Apple\\\", 0)\\n        assert inv.get_quantity(\\\"Apple\\\") == 10\\n\\n    def test_multiple_operations(self):\\n        inv = Inventory()\\n        inv.add(\\\"Apple\\\", 100, 1.00)\\n        inv.add(\\\"Banana\\\", 50, 0.50)\\n        inv.remove(\\\"Apple\\\", 20)\\n        inv.restock(\\\"Banana\\\", 10)\\n        assert inv.get_quantity(\\\"Apple\\\") == 80\\n        assert 